<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../web'))</UiRoot>
        <MonoReportUiDist Condition="'$(MonoReportUiDist)' == ''">$(UiRoot)/dist</MonoReportUiDist>
        <MonoReportUiVersion Condition="'$(MonoReportUiVersion)' == ''">dev</MonoReportUiVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1"/>
        <ProjectReference Include="../MonoReport/MonoReport.csproj"/>
        <ProjectReference Include="../MonoReport.Formatter.Spellout/MonoReport.Formatter.Spellout.csproj"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
    </ItemGroup>
    <Target Name="BuildProductionUi" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' and '$(MonoReportSkipUiBuild)' != 'true'">
        <RemoveDir Directories="$(MonoReportUiDist)"/>
        <Exec WorkingDirectory="$(UiRoot)" Command="npm ci"/>
        <Exec WorkingDirectory="$(UiRoot)" Command="npm run build" EnvironmentVariables="MONOREPORT_VERSION=$(MonoReportUiVersion)"/>
    </Target>
    <Target Name="IncludeProductionUi" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildProductionUi" Condition="'$(Configuration)' == 'Release'">
        <Error Condition="!Exists('$(MonoReportUiDist)/index.html')" Text="Production UI assets were not found at $(MonoReportUiDist). Build the UI or remove MonoReportSkipUiBuild."/>
        <ItemGroup>
            <UiAsset Include="$(MonoReportUiDist)/**/*"/>
            <ResolvedFileToPublish Include="@(UiAsset->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
