<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14"/>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MonoReport\MonoReport.csproj"/>
        <ProjectReference Include="..\MonoReport.Formatter.Spellout\MonoReport.Formatter.Spellout.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Fixtures/feature012/*" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="Fixtures/XlsxCompatibility/*.xlsx" CopyToOutputDirectory="PreserveNewest"/>
        <None Condition="Exists('../Samples/sample.template.docx')" Include="../Samples/sample.template.docx" Link="sample.template.docx" CopyToOutputDirectory="PreserveNewest"/>
        <None Condition="Exists('../Samples/sample.json')" Include="../Samples/sample.json" Link="sample.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Condition="Exists('../Samples/sample.docx')" Include="../Samples/sample.docx" Link="sample.docx" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../Samples/orders-report.*;../Samples/project-costs.*;../Samples/syntax-showcase.*;../Samples/repeated-image.*;../Samples/xlsx-tender.*;../Samples/xlsx-employees.*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../MonoReport.Tests/Fixtures/review-reproductions/*.template.docx;../MonoReport.Tests/Fixtures/review-reproductions/*.json" Link="Fixtures/review-reproductions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../MonoReport.Tests/Fixtures/review-verification/*.template.docx;../MonoReport.Tests/Fixtures/review-verification/*.json" Link="Fixtures/review-verification/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Condition="Exists('../web/public/examples.json')" Include="../web/public/examples.json" Link="examples.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
</Project>
