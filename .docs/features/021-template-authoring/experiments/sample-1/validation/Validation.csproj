<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <RestoreSources>$(MSBuildThisFileDirectory)</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>$(HOME)/.nuget/packages/documentformat.openxml/3.5.1/lib/net10.0/DocumentFormat.OpenXml.dll</HintPath>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml.Framework">
      <HintPath>$(HOME)/.nuget/packages/documentformat.openxml.framework/3.5.1/lib/net10.0/DocumentFormat.OpenXml.Framework.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Packaging">
      <HintPath>$(HOME)/.nuget/packages/system.io.packaging/10.0.2/lib/net10.0/System.IO.Packaging.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
