+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { resolvePrintArea } from './internal/viewer/print-area-overlay.js';
+import { XlsxViewer } from './viewer.js';
+import { XlsxWorkbook } from './workbook.js';
+import type { Worksheet } from './types.js';
+import { installDom, makeContainer, type FakeEl } from './viewer-destroy-test-dom.js';
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+function worksheet(name: string, formula?: string): Worksheet {
+  return {
+    name, rows: [], colWidths: {}, rowHeights: {}, defaultColWidth: 8.43,
+    defaultRowHeight: 15, mergeCells: [], freezeRows: 0, freezeCols: 0,
+    conditionalFormats: [], images: [], charts: [],
+    definedNames: formula === undefined ? [] : [{ name: '_xlnm.Print_Area', formula }],
+  } as unknown as Worksheet;
+}
+
+function descendants(element: FakeEl): FakeEl[] {
+  return element.children.flatMap(child => [child, ...descendants(child)]);
+}
+
+describe('Print Area references', () => {
+  it('reads quoted names, escaped apostrophes, ranges and single cells', () => {
+    expect(resolvePrintArea(worksheet("O'Brien, Q1!", "'O''Brien, Q1!'!$B$3:$D$8")))
+      .toMatchObject({ top: 3, left: 2, bottom: 8, right: 4 });
+    expect(resolvePrintArea(worksheet('Report', 'Report!XFD1048576')))
+      .toMatchObject({ top: 1048576, left: 16384, bottom: 1048576, right: 16384 });
+  });
+
+  it.each([
+    undefined, 'Report!$B:$D', 'Report!$2:$4', 'Report!A1:B2,Report!D1:E2',
+    'OFFSET(Report!A1,0,0,5,4)', 'NamedArea', 'Other!A1:B2',
+    'Report!D8:B3', 'Report!A0:B2', 'Report!A1:XFE2', "'[Other.xlsx]Report'!A1:B2",
+  ])('leaves missing or unsupported definitions unresolved: %s', formula => {
+    expect(resolvePrintArea(worksheet('Report', formula))).toBeNull();
+  });
+
+  it('separates workbook-global areas by worksheet and refuses conflicting local scope', () => {
+    const first = worksheet('First', 'First!A1:B2');
+    first.definedNames!.push({ name: '_xlnm.Print_Area', formula: 'Second!D3:F8' });
+    expect(resolvePrintArea(first)).toMatchObject({ top: 1, left: 1, bottom: 2, right: 2 });
+    expect(resolvePrintArea({ ...first, name: 'Second' })).toMatchObject({ top: 3, left: 4, bottom: 8, right: 6 });
+    first.definedNames![1].localSheetId = '0';
+    expect(resolvePrintArea(first)).toBeNull();
+    first.definedNames = [{ name: '_xlnm.Print_Area', formula: 'First!A1:B2', localSheetId: 'invalid' }];
+    expect(resolvePrintArea(first)).toBeNull();
+  });
+
+  it('rejects duplicate definitions instead of selecting one', () => {
+    const ws = worksheet('Report', 'Report!A1:B2');
+    ws.definedNames!.push({ name: '_xlnm.Print_Area', formula: 'Report!C3:D4' });
+    expect(resolvePrintArea(ws)).toBeNull();
+  });
+});
+
+async function preview(sheets: Worksheet[], mode: 'main' | 'worker' = 'main') {
+  const doc = installDom();
+  const resizeCallbacks: Array<() => void> = [];
+  doc.defaultView.ResizeObserver = class {
+    constructor(callback: () => void) { resizeCallbacks.push(callback); }
+    observe() {}
+    disconnect() {}
+    unobserve() {}
+  };
+  const container = makeContainer();
+  const selectionChanged = vi.fn();
+  const viewer = new XlsxViewer(container as unknown as HTMLElement, { mode, onSelectionStateChange: selectionChanged });
+  const area = viewer.canvasElement.parentElement as unknown as FakeEl;
+  area.clientWidth = 640;
+  area.clientHeight = 360;
+  const scroll = area.children.find(child => child._listeners.has('scroll'))!;
+  scroll.clientWidth = 640;
+  scroll.clientHeight = 360;
+  scroll.scrollWidth = 4000;
+  scroll.scrollHeight = 4000;
+  const workbook = {
+    mode, sheetNames: sheets.map(sheet => sheet.name), sheetCount: sheets.length,
+    tabColors: sheets.map(() => null), isHidden: () => false,
+    getWorksheet: vi.fn(async (index: number) => sheets[index]),
+    acquireWorksheetLease: vi.fn(async (index: number) => ({ worksheet: sheets[index], release: vi.fn() })),
+    retainWorksheetReference: vi.fn(async () => vi.fn()),
+    renderViewport: vi.fn(async () => undefined),
+    renderViewportToBitmap: vi.fn(async () => ({ close() {} })),
+    destroy: vi.fn(),
+  };
+  vi.spyOn(XlsxWorkbook, 'load').mockResolvedValue(workbook as unknown as XlsxWorkbook);
+  await viewer.load(new ArrayBuffer(0));
+  const decoration = () => descendants(container).find(element => element.hasAttribute('data-xlsx-print-area'));
+  const paths = () => decoration()?.children.map(path => path.getAttribute('d')) ?? [];
+  return { viewer, container, area, scroll, workbook, selectionChanged, resizeCallbacks, decoration, paths };
+}
+
+// Sample the emitted even-odd shading against public cell hit-testing. This
+// catches pane overlap, header shading and incorrect RTL clipping without a browser.
+function expectShadingMatchesCells(view: Awaited<ReturnType<typeof preview>>, top: number, left: number) {
+  const path = view.paths()[0] ?? '';
+  const rectangles = [...path.matchAll(/M(-?[\d.]+) (-?[\d.]+)h(-?[\d.]+)v(-?[\d.]+)h-?[\d.]+Z/g)]
+    .map(match => match.slice(1).map(Number));
+  for (let y = 11.5; y < view.area.clientHeight; y += 29) {
+    for (let x = 13.5; x < view.area.clientWidth; x += 31) {
+      const cell = view.viewer.getCellAt(x, y);
+      const shaded = rectangles.filter(([left, top, width, height]) =>
+        x > left && x < left + width && y > top && y < top + height).length % 2 === 1;
+      const outside = cell !== null && (cell.row < top || cell.col < left || cell.row > 20 || cell.col > 8);
+      expect(shaded, `Shading at ${x},${y} for cell ${JSON.stringify(cell)}`).toBe(outside);
+    }
+  }
+}
+
+describe('Print Area viewer decoration', () => {
+  it('defaults off, follows each worksheet and toggles without changing selection or the source model', async () => {
+    const sheets = [worksheet('First', 'First!B3:D8'), worksheet('Second', 'Second!E2:H5'), worksheet('None')];
+    const original = JSON.stringify(sheets);
+    const view = await preview(sheets);
+    expect(view.decoration()).toBeUndefined();
+    view.viewer.setSelection('C4:D5');
+    const selection = view.viewer.selectionState;
+    const notifications = view.selectionChanged.mock.calls.length;
+    view.viewer.setShowPrintArea(true);
+    expect(view.decoration()).toBeDefined();
+    const first = view.paths();
+    expect(view.viewer.selectionState).toEqual(selection);
+    expect(view.selectionChanged).toHaveBeenCalledTimes(notifications);
+    view.viewer.setShowPrintArea(false);
+    expect(view.decoration()).toBeUndefined();
+    expect(view.viewer.selectionState).toEqual(selection);
+    view.viewer.setShowPrintArea(true);
+    await view.viewer.goToSheet(1);
+    expect(view.paths()).not.toEqual(first);
+    await view.viewer.goToSheet(2);
+    expect(view.decoration()).toBeUndefined();
+    await view.viewer.goToSheet(0);
+    expect(view.paths()).toEqual(first);
+    expect(JSON.stringify(sheets)).toBe(original);
+    view.viewer.destroy();
+    expect(view.workbook.destroy).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    { rightToLeft: false, first: 'A1', top: 1, left: 1 },
+    { rightToLeft: true, first: 'A1', top: 1, left: 1 },
+    { rightToLeft: false, first: 'B3', top: 3, left: 2 },
+    { rightToLeft: true, first: 'B3', top: 3, left: 2 },
+  ])('tracks scrolling, zoom, resize and frozen panes from $first with RTL=$rightToLeft', async ({ rightToLeft, first, top, left }) => {
+    const sheet = worksheet('Report', `Report!${first}:H20`);
+    sheet.freezeRows = 2;
+    sheet.freezeCols = 2;
+    sheet.rightToLeft = rightToLeft;
+    const view = await preview([sheet], 'worker');
+    view.viewer.setShowPrintArea(true);
+    expectShadingMatchesCells(view, top, left);
+    const initial = view.paths();
+    let completeFrame!: (bitmap: { close(): void }) => void;
+    view.workbook.renderViewportToBitmap.mockImplementationOnce(() => new Promise(resolve => { completeFrame = resolve; }));
+    const movement = view.viewer.setViewportOffset({ x: 120, y: 100 });
+    expect(view.paths()).toEqual(initial);
+    completeFrame({ close() {} });
+    await movement;
+    expect(view.paths()).not.toEqual(initial);
+    expectShadingMatchesCells(view, top, left);
+    const scrolled = view.paths();
+    view.viewer.setScale(1.5);
+    await view.viewer.relayout();
+    expect(view.paths()).not.toEqual(scrolled);
+    expectShadingMatchesCells(view, top, left);
+    const zoomed = view.paths();
+    view.area.clientWidth = 480;
+    view.area.clientHeight = 260;
+    view.scroll.clientWidth = 480;
+    view.scroll.clientHeight = 260;
+    for (const resize of view.resizeCallbacks) resize();
+    expect(view.paths()).not.toEqual(zoomed);
+    expectShadingMatchesCells(view, top, left);
+    const svg = view.decoration()!;
+    expect(svg.getAttribute('aria-hidden')).toBe('true');
+    expect(svg.children[0].getAttribute('fill-rule')).toBe('evenodd');
+    view.viewer.destroy();
+  });
+});
