diff --git a/packages/xlsx/src/internal/viewer/print-area-overlay.ts b/packages/xlsx/src/internal/viewer/print-area-overlay.ts
new file mode 100644
--- /dev/null
+++ b/packages/xlsx/src/internal/viewer/print-area-overlay.ts
@@ -0,0 +1,85 @@
+import { parseA1 } from '../../a1.js';
+import type { Worksheet } from '../../types.js';
+import type { SheetOverlayHost } from '../sheet-surface.js';
+import { projectRangeOverlay, rangeBoundaryPath, rangeOverlayLayout, type RangeOverlayBounds, type RangeOverlayHost } from './range-overlay.js';
+
+const PRINT_AREA_NAME = '_xlnm.Print_Area';
+const MAX_LOCAL_SHEET_ID = 0xffffffff;
+const SVG_NAMESPACE = 'http://www.w3.org/2000/svg';
+const PRINT_AREA_COLOR = '#64748b';
+
+/** ECMA-376 §18.2.5: Print_Area is a reserved defined name, not page setup.
+ * Viewer policy: only one direct, sheet-qualified finite rectangle is drawn.
+ * Names, formulas, unions and duplicate definitions are intentionally unresolved. */
+export function resolvePrintArea(ws: Worksheet): RangeOverlayBounds | null {
+  const definitions = (ws.definedNames ?? []).filter((name) => name.name === PRINT_AREA_NAME);
+  const candidates: RegExpExecArray[] = [];
+  for (const definition of definitions) {
+    if (definition.localSheetId !== undefined
+      && (!/^[0-9]+$/.test(definition.localSheetId) || Number(definition.localSheetId) > MAX_LOCAL_SHEET_ID)) return null;
+    const reference = /^(?:'((?:[^']|'')+)'|([^'!,:\[\]]+))!(\$?[A-Z]{1,3}\$?[1-9][0-9]*)(?::(\$?[A-Z]{1,3}\$?[1-9][0-9]*))?$/.exec(definition.formula);
+    // An unresolved global definition could target this sheet; never guess.
+    if (!reference) return null;
+    const sheetName = reference[1] !== undefined ? reference[1].replace(/''/g, "'") : reference[2];
+    if (sheetName === ws.name) candidates.push(reference);
+    else if (definition.localSheetId !== undefined) return null;
+  }
+  if (candidates.length !== 1) return null;
+  const reference = candidates[0];
+  const first = parseA1(reference[3]);
+  const last = parseA1(reference[4] ?? reference[3]);
+  if (!first || !last || first.row > last.row || first.col > last.col) return null;
+  return {
+    top: first.row, left: first.col, bottom: last.row, right: last.col,
+    topEdge: true, bottomEdge: true, leftEdge: true, rightEdge: true,
+  };
+}
+
+interface PrintAreaOverlayHost extends RangeOverlayHost {
+  readonly ownerDocument: Document;
+  readonly overlayHost: SheetOverlayHost;
+  enabled(): boolean;
+}
+
+/** Noninteractive decoration with no selection/controller state or workbook writes. */
+export class PrintAreaOverlay {
+  private readonly areas = new WeakMap<Worksheet, RangeOverlayBounds | null>();
+
+  constructor(private readonly host: PrintAreaOverlayHost) {}
+
+  update(): void {
+    this.host.overlayHost.printArea.textContent = '';
+    const ws = this.host.worksheet();
+    if (!this.host.enabled() || !ws) return;
+    if (!this.areas.has(ws)) this.areas.set(ws, resolvePrintArea(ws));
+    const area = this.areas.get(ws);
+    if (!area) return;
+    const layout = rangeOverlayLayout(this.host, ws);
+    const { width, height, headerW, headerH } = layout;
+    const bodyWidth = Math.max(0, width - headerW);
+    const bodyHeight = Math.max(0, height - headerH);
+    if (bodyWidth === 0 || bodyHeight === 0) return;
+    const { fillSubpaths, overlayRects } = projectRangeOverlay(layout, area);
+    const svg = this.host.ownerDocument.createElementNS(SVG_NAMESPACE, 'svg');
+    svg.setAttribute('aria-hidden', 'true');
+    svg.setAttribute('data-xlsx-print-area', '');
+    svg.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;overflow:hidden;pointer-events:none;';
+    const shade = this.host.ownerDocument.createElementNS(SVG_NAMESPACE, 'path');
+    const bodyLeft = this.host.screenX(headerW, bodyWidth);
+    shade.setAttribute('d', `M${bodyLeft} ${headerH}h${bodyWidth}v${bodyHeight}h${-bodyWidth}Z${fillSubpaths.join('')}`);
+    shade.setAttribute('fill-rule', 'evenodd');
+    shade.setAttribute('fill', PRINT_AREA_COLOR);
+    shade.setAttribute('fill-opacity', '0.12');
+    svg.appendChild(shade);
+    const boundaryPath = rangeBoundaryPath(overlayRects);
+    if (boundaryPath) {
+      const boundary = this.host.ownerDocument.createElementNS(SVG_NAMESPACE, 'path');
+      boundary.setAttribute('d', boundaryPath);
+      boundary.setAttribute('fill', 'none');
+      boundary.setAttribute('stroke', PRINT_AREA_COLOR);
+      boundary.setAttribute('stroke-width', '2');
+      svg.appendChild(boundary);
+    }
+    this.host.overlayHost.printArea.appendChild(svg);
+  }
+}
diff --git a/packages/xlsx/src/internal/viewer/range-overlay.ts b/packages/xlsx/src/internal/viewer/range-overlay.ts
new file mode 100644
--- /dev/null
+++ b/packages/xlsx/src/internal/viewer/range-overlay.ts
@@ -0,0 +1,218 @@
+import type { Worksheet } from '../../types.js';
+import { HEADER_W, HEADER_H, getGridGeometryForWorksheet } from '../../renderer.js';
+import { MAX_WORKSHEET_COL, MAX_WORKSHEET_ROW } from '../grid-geometry.js';
+
+export interface RangeOverlayHost {
+  readonly canvasArea: HTMLDivElement;
+  worksheet(): Worksheet | null;
+  scale(): number;
+  isRtl(): boolean;
+  cellRect(row: number, col: number): { x: number; y: number; w: number; h: number } | null;
+  screenX(logicalX: number, width: number): number;
+}
+
+export interface RangeOverlayBounds {
+  readonly top: number;
+  readonly bottom: number;
+  readonly left: number;
+  readonly right: number;
+  readonly topEdge: boolean;
+  readonly bottomEdge: boolean;
+  readonly leftEdge: boolean;
+  readonly rightEdge: boolean;
+}
+
+export interface RangeOverlayRect {
+  readonly x: number;
+  readonly y: number;
+  readonly width: number;
+  readonly height: number;
+  readonly top: boolean;
+  readonly right: boolean;
+  readonly bottom: boolean;
+  readonly left: boolean;
+}
+
+interface RangeBoundarySegment {
+  readonly axis: 'h' | 'v';
+  readonly fixed: number;
+  readonly start: number;
+  readonly end: number;
+}
+
+/**
+ * Build the single-Area outline from its visible frozen-pane fragments.
+ * Splitting collinear edges at every endpoint emits coincident fragment edges
+ * only once. Work is bounded by the visible fragment count, not sheet size.
+ */
+export function rangeBoundaryPath(rects: readonly RangeOverlayRect[]): string {
+  const raw: RangeBoundarySegment[] = [];
+  for (const rect of rects) {
+    const x2 = rect.x + rect.width;
+    const y2 = rect.y + rect.height;
+    if (rect.top) raw.push({ axis: 'h', fixed: rect.y, start: rect.x, end: x2 });
+    if (rect.right) raw.push({ axis: 'v', fixed: x2, start: rect.y, end: y2 });
+    if (rect.bottom) raw.push({ axis: 'h', fixed: y2, start: rect.x, end: x2 });
+    if (rect.left) raw.push({ axis: 'v', fixed: rect.x, start: rect.y, end: y2 });
+  }
+
+  const groups = new Map<string, RangeBoundarySegment[]>();
+  for (const segment of raw) {
+    const key = `${segment.axis}:${segment.fixed}`;
+    const group = groups.get(key);
+    if (group) group.push(segment);
+    else groups.set(key, [segment]);
+  }
+
+  const commands: string[] = [];
+  for (const segments of groups.values()) {
+    const points = [...new Set(segments.flatMap(({ start, end }) => [start, end]))]
+      .sort((a, b) => a - b);
+    let runStart: number | null = null;
+    let runEnd = 0;
+    const flush = () => {
+      if (runStart === null || runEnd <= runStart) return;
+      const { axis, fixed } = segments[0];
+      commands.push(axis === 'h'
+        ? `M${runStart} ${fixed}H${runEnd}`
+        : `M${fixed} ${runStart}V${runEnd}`);
+      runStart = null;
+    };
+    for (let index = 0; index + 1 < points.length; index++) {
+      const start = points[index];
+      const end = points[index + 1];
+      const covered = segments.some((segment) => segment.start < end && segment.end > start);
+      if (covered && runStart !== null && start === runEnd) {
+        runEnd = end;
+      } else {
+        flush();
+        if (covered) {
+          runStart = start;
+          runEnd = end;
+        }
+      }
+    }
+    flush();
+  }
+  return commands.join('');
+}
+
+/** Shared selection/decorations projection, bounded by the visible frozen panes. */
+export function rangeOverlayLayout(host: RangeOverlayHost, ws: Worksheet) {
+  const cs = host.scale();
+  const sp = (px: number) => Math.round(px * cs);
+  const headerW = sp(HEADER_W);
+  const headerH = sp(HEADER_H);
+  const width = host.canvasArea.clientWidth;
+  const height = host.canvasArea.clientHeight;
+  const geometry = getGridGeometryForWorksheet(ws);
+  // Match renderViewport's physical freeze materialization. A legal freeze
+  // count may cover the full sheet; it must never create million-row overlay
+  // geometry when only a handful of bands can reach this viewport.
+  const effective = geometry.effectiveFrozenBands({
+    scale: cs, width, height, headerWidth: HEADER_W, headerHeight: HEADER_H,
+    rows: ws.freezeRows ?? 0, cols: ws.freezeCols ?? 0,
+  });
+  const axes = geometry.axesAtScale(cs);
+  const frozenW = axes.col.offsetOf(effective.cols + 1);
+  const frozenH = axes.row.offsetOf(effective.rows + 1);
+  const xPanes = effective.cols > 0
+    ? [
+        { first: 1, last: effective.cols, start: headerW, end: Math.min(width, headerW + frozenW) },
+        { first: effective.cols + 1, last: MAX_WORKSHEET_COL, start: Math.min(width, headerW + frozenW), end: width },
+      ]
+    : [{ first: 1, last: MAX_WORKSHEET_COL, start: headerW, end: width }];
+  const yPanes = effective.rows > 0
+    ? [
+        { first: 1, last: effective.rows, start: headerH, end: Math.min(height, headerH + frozenH) },
+        { first: effective.rows + 1, last: MAX_WORKSHEET_ROW, start: Math.min(height, headerH + frozenH), end: height },
+      ]
+    : [{ first: 1, last: MAX_WORKSHEET_ROW, start: headerH, end: height }];
+  const visibleXPanes = xPanes.filter((pane) => pane.end > pane.start);
+  const visibleYPanes = yPanes.filter((pane) => pane.end > pane.start);
+  return { host, width, height, headerW, headerH, xPanes, yPanes, visibleXPanes, visibleYPanes };
+}
+
+export function projectRangeOverlay(
+  layout: ReturnType<typeof rangeOverlayLayout>,
+  bounds: RangeOverlayBounds,
+  kind: 'cells' | 'rows' | 'columns' | 'sheet' = 'cells',
+) {
+  const { host, width, height, visibleXPanes, visibleYPanes } = layout;
+  const seenFragments = new Set<string>();
+  const fillSubpaths: string[] = [];
+  const overlayRects: RangeOverlayRect[] = [];
+  for (const yp of visibleYPanes) for (const xp of visibleXPanes) {
+    const top = Math.max(bounds.top, yp.first);
+    const bottom = Math.min(bounds.bottom, yp.last);
+    const left = Math.max(bounds.left, xp.first);
+    const right = Math.min(bounds.right, xp.last);
+    if (top > bottom || left > right) continue;
+    const tl = host.cellRect(top, left);
+    const br = host.cellRect(bottom, right);
+    if (!tl || !br) continue;
+    const rawLeft = tl.x;
+    const rawTop = tl.y;
+    const rawRight = br.x + br.w;
+    const rawBottom = br.y + br.h;
+    const x = Math.max(rawLeft, xp.start);
+    const y = Math.max(rawTop, yp.start);
+    const x2 = Math.min(rawRight, xp.end);
+    const y2 = Math.min(rawBottom, yp.end);
+    const fragmentW = x2 - x;
+    const fragmentH = y2 - y;
+    if (fragmentW <= 0 || fragmentH <= 0) continue;
+
+    // Whole rows/columns use the outer visible grid along their unbounded
+    // axis. Only outer nonempty panes receive caps; frozen seams and clipped
+    // ordinary cell ranges remain open. This is viewer selection chrome.
+    const topCap = kind === 'columns' && yp === visibleYPanes[0];
+    const bottomCap = kind === 'columns' && yp === visibleYPanes.at(-1);
+    const leftCap = kind === 'rows' && xp === visibleXPanes[0];
+    const rightCap = kind === 'rows' && xp === visibleXPanes.at(-1);
+    const topBorder = topCap || (bounds.topEdge && top === bounds.top && rawTop >= yp.start);
+    const bottomBorder = bottomCap || (bounds.bottomEdge && bottom === bounds.bottom && rawBottom <= yp.end);
+    const leftBorder = leftCap || (bounds.leftEdge && left === bounds.left && rawLeft >= xp.start);
+    const rightBorder = rightCap || (bounds.rightEdge && right === bounds.right && rawRight <= xp.end);
+    const screenLeft = host.screenX(x, fragmentW);
+    const physicalLeftBorder = host.isRtl() ? rightBorder : leftBorder;
+    const physicalRightBorder = host.isRtl() ? leftBorder : rightBorder;
+    const fragmentKey = [
+      screenLeft, y, fragmentW, fragmentH,
+      topBorder, physicalRightBorder, bottomBorder, physicalLeftBorder,
+    ].join('|');
+    if (seenFragments.has(fragmentKey)) continue;
+    seenFragments.add(fragmentKey);
+    // Paint every fragment as a subpath in one SVG fill operation. With a
+    // single non-zero fill, overlapping selection areas form a visual union
+    // instead of stacking translucent backgrounds and becoming darker.
+    fillSubpaths.push(
+      `M${screenLeft} ${y}h${fragmentW}v${fragmentH}h${-fragmentW}Z`,
+    );
+    // A cap on the overlay's own edge (bottom, right, or the physical left
+    // edge in RTL) is inset by half the centered 2 CSS-pixel stroke so the
+    // clip keeps the whole stroke. A cap beside the row/column headers sits
+    // on the grid line, exactly where an ordinary cell selection draws it.
+    const insetX = Math.min(1, fragmentW / 2);
+    const insetY = Math.min(1, fragmentH / 2);
+    const physicalLeftCap = host.isRtl() ? rightCap : leftCap;
+    const physicalRightCap = host.isRtl() ? leftCap : rightCap;
+    const atOverlayEdge = (edge: number, limit: number) => edge <= 0 || edge >= limit;
+    const outlineLeft = screenLeft + (physicalLeftCap && atOverlayEdge(screenLeft, width) ? insetX : 0);
+    const outlineRight = screenLeft + fragmentW
+      - (physicalRightCap && atOverlayEdge(screenLeft + fragmentW, width) ? insetX : 0);
+    const outlineTop = y + (topCap && atOverlayEdge(y, height) ? insetY : 0);
+    const outlineBottom = y2 - (bottomCap && atOverlayEdge(y2, height) ? insetY : 0);
+    overlayRects.push({
+      x: outlineLeft,
+      y: outlineTop,
+      width: outlineRight - outlineLeft,
+      height: outlineBottom - outlineTop,
+      top: topBorder,
+      right: physicalRightBorder,
+      bottom: bottomBorder,
+      left: physicalLeftBorder,
+    });
+  }
+  return { fillSubpaths, overlayRects };
+}
