diff --git a/web/scripts/local-ooxml.mjs b/web/scripts/local-ooxml.mjs
new file mode 100644
index 0000000..bd64d0c
--- /dev/null
+++ b/web/scripts/local-ooxml.mjs
@@ -0,0 +1,82 @@
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const webRoot = fileURLToPath(new URL("../", import.meta.url));
+const [source, action, ...args] = process.argv.slice(2);
+const actions = new Set(["build-library", "dev", "test", "typecheck", "build"]);
+if (!source || !actions.has(action)) {
+  throw new Error("Usage: npm run ooxml:local -- <upstream-source-directory> <build-library|dev|test|typecheck|build> [arguments]");
+}
+const sourceRoot = path.resolve(source);
+const sourcePackage = JSON.parse(readFileSync(path.join(sourceRoot, "package.json"), "utf8"));
+if (sourcePackage.name !== "@silurus/ooxml" || sourcePackage.version !== "0.89.8") {
+  throw new Error("The local build requires the @silurus/ooxml 0.89.8 source tree.");
+}
+const distribution = path.join(sourceRoot, "packages/xlsx/dist");
+const localEntry = path.join(distribution, "xlsx.mjs");
+const localTypes = path.join(distribution, "types/index.d.ts");
+
+function run(command, arguments_, cwd = sourceRoot, env = process.env) {
+  const result = spawnSync(command, arguments_, { cwd, env, stdio: "inherit" });
+  if (result.error) throw result.error;
+  if (result.status !== 0) throw new Error(`${command} exited with ${result.status ?? result.signal}`);
+}
+
+if (action === "build-library") {
+  const require = createRequire(path.join(sourceRoot, "package.json"));
+  const tsc = path.join(sourceRoot, "node_modules/typescript/bin/tsc");
+  run("wasm-pack", ["build", "--target", "web", "--out-dir", "../src/wasm", "--", "--locked"],
+    path.join(sourceRoot, "packages/xlsx/parser"));
+  run(process.execPath, ["scripts/append-wasm-reinit.mjs", "packages/xlsx/src/wasm/xlsx_parser.js"]);
+  run(process.execPath, [tsc, "--build", "packages/core"]);
+  const { default: configuration } = await import(pathToFileURL(path.join(sourceRoot, "vite.config.ts")));
+  const { build } = await import(pathToFileURL(require.resolve("vite")));
+  // Reuse the release configuration, including its self-contained render worker.
+  // Limit entry points to XLSX so unchanged DOCX/PPTX parsers need not be built.
+  const base = configuration({ command: "build", mode: "runtime", isSsrBuild: false, isPreview: false });
+  await build({
+    ...base,
+    configFile: false,
+    root: sourceRoot,
+    build: {
+      ...base.build,
+      outDir: distribution,
+      lib: {
+        ...base.build.lib,
+        entry: { xlsx: path.join(sourceRoot, "src/xlsx.ts") },
+        formats: ["es"]
+      }
+    }
+  });
+  run(process.execPath, ["scripts/build-model-source-sidecars.mjs", "xlsx"]);
+  run(process.execPath, [tsc, "-p", "packages/xlsx/tsconfig.declarations.json"]);
+} else {
+  readFileSync(localTypes);
+  const { XlsxViewer } = await import(pathToFileURL(localEntry));
+  if (typeof XlsxViewer.prototype.setShowPrintArea !== "function") {
+    throw new Error("Build the local Print Area library before using it in Playground.");
+  }
+  const env = { ...process.env, MONOREPORT_OOXML_XLSX: localEntry };
+  if (action === "typecheck") {
+    const directory = mkdtempSync(path.join(tmpdir(), "monoreport-ooxml-typecheck-"));
+    try {
+      const config = path.join(directory, "tsconfig.json");
+      writeFileSync(config, JSON.stringify({
+        extends: path.join(webRoot, "tsconfig.json"),
+        compilerOptions: {
+          paths: { "@silurus/ooxml/xlsx": [localTypes] },
+          typeRoots: [path.join(webRoot, "node_modules/@types"), path.join(webRoot, "node_modules")]
+        }
+      }));
+      run("npm", ["run", "typecheck", "--", "--project", config, ...args], webRoot, env);
+    } finally {
+      rmSync(directory, { recursive: true });
+    }
+  } else {
+    run("npm", ["run", action, "--", ...args], webRoot, env);
+  }
+}
diff --git a/web/src/hooks/useXlsxPrintArea.ts b/web/src/hooks/useXlsxPrintArea.ts
new file mode 100644
index 0000000..191bfb7
--- /dev/null
+++ b/web/src/hooks/useXlsxPrintArea.ts
@@ -0,0 +1,30 @@
+import { useCallback, useRef, useState } from "react";
+import type { XlsxViewer } from "@silurus/ooxml/xlsx";
+
+type PrintAreaViewer = XlsxViewer & { setShowPrintArea(show: boolean): void };
+
+function supportsPrintArea(viewer: XlsxViewer | undefined): viewer is PrintAreaViewer {
+  return !!viewer && "setShowPrintArea" in viewer && typeof viewer.setShowPrintArea === "function";
+}
+
+export function useXlsxPrintArea() {
+  const current = useRef<XlsxViewer | undefined>(undefined);
+  const preference = useRef(false);
+  const [visible, setVisible] = useState(false);
+  const [available, setAvailable] = useState(false);
+
+  const attachViewer = useCallback((viewer: XlsxViewer | undefined) => {
+    current.current = viewer;
+    const supported = supportsPrintArea(viewer);
+    if (supported) viewer.setShowPrintArea(preference.current);
+    setAvailable(supported);
+  }, []);
+
+  const changeVisibility = useCallback((show: boolean) => {
+    preference.current = show;
+    if (supportsPrintArea(current.current)) current.current.setShowPrintArea(show);
+    setVisible(show);
+  }, []);
+
+  return { visible, available, attachViewer, changeVisibility };
+}
